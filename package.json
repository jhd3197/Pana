{
  "name": "pana",
  "version": "0.4.0",
  "private": true,
  "description": "Pana — juega con tus panas. A hub of free multiplayer browser games.",
  "type": "module",
  "workspaces": [
    "Pana/server"
  ],
  "scripts": {
    "start": "node Pana/server/src/index.js",
    "check": "node Pana/server/src/check.js",
    "test": "node Pana/scripts/test-unit.js",
    "test:browser": "node Pana/scripts/test-browser.js",
    "shots": "node Pana/scripts/shots.js",
    "budget": "node Pana/scripts/budget.js",
    "launcher-art": "node Pana/scripts/launcher-art.js",
    "inventory": "node Pana/scripts/model-inventory.js",
    "new-game": "node Pana/scripts/new-game.js",
    "dev": "powershell -ExecutionPolicy Bypass -File dev.ps1",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pana": "file:"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
