<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{color}}">
  <meta name="description" content="{{description}}">
  <title>{{name}} · Pana</title>
  <link rel="stylesheet" href="/engine/kit.css">
  <link rel="stylesheet" href="/engine/ui.css">
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="/engine/game-lobby.css">
  <link rel="stylesheet" href="/engine/room-options.css">
  <script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.186.1/build/three.module.js","three/addons/":"https://cdn.jsdelivr.net/npm/three@0.186.1/examples/jsm/"}}</script>
</head>
<body class="in-lobby">
  <canvas id="world" aria-label="La plaza de {{name}} en tres dimensiones"></canvas>
  <header class="topbar"><a class="pk-logo" href="/" aria-label="Volver a Pana">PANA</a><nav id="game-nav" aria-label="Opciones"></nav></header>
  <!-- game-entry supplies the shared Carreritas side-settings lobby. -->
  <section id="lobby" class="pk-lobby" aria-labelledby="lobby-title">
    <span class="pk-ribbon">LA PLAZA ESTÁ LISTA</span>
    <h1 id="lobby-title" class="pk-title">{{name}}</h1>
    <p class="pk-copy" data-room-description>{{description}}</p>
    <ol id="roster" class="pk-roster" aria-label="Panas en la plaza" data-room-description></ol>
    <button id="rules" class="pk-btn pk-btn--ghost" data-room-help>Cómo se juega</button>
    <div id="room-options"></div>
    <div class="pk-lobby-foot"><button id="start" class="pk-btn pk-btn--primary pk-btn--lg" disabled>Conectando…</button></div>
  </section>
  <main id="hud" hidden>
    <section class="status-panel pk-panel" aria-label="Tu ronda"><b id="timer" class="pk-heading"></b><span id="score"></span><span id="event" role="status"></span></section>
    <div id="touch" class="pk-touch-zone"><div class="pk-dpad"><button id="up" class="pk-touch" data-icon="up" aria-label="Arriba"></button><button id="left" class="pk-touch" data-icon="left" aria-label="Izquierda"></button><button id="down" class="pk-touch" data-icon="down" aria-label="Abajo"></button><button id="right" class="pk-touch" data-icon="right" aria-label="Derecha"></button></div></div>
  </main>
  <div class="connection"><span id="connection" role="status">Conectando…</span><button id="practice" class="pk-btn pk-btn--sm" hidden>Jugar en local</button></div>
  <section id="results" class="pk-results" hidden aria-labelledby="result-title"><div class="pk-modal pk-results-card"><span class="pk-ribbon">FIN DE LA RONDA</span><h2 id="result-title" class="pk-title"></h2><ol id="result-roster" class="pk-roster"></ol><button id="again" class="pk-btn pk-btn--primary pk-btn--block">Otra ronda</button><a class="pk-back" href="/">Todos los juegos</a></div></section>
  <div id="loading" class="pk-loading"><div class="pk-panel"><h2 class="pk-heading">Preparando {{name}}</h2><p>Llenando la plaza de mangos…</p></div></div>
  <script type="module" src="/engine/game-entry.js" data-pana-entry="./game.js"></script>
</body>
</html>
