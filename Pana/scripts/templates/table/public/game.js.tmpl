// Wiring only: input → rules (through the room) → scene and HUD.
import { loadName, loadAvatar } from '/engine/avatar.js';
import { createGameMenu, toggleMute } from '/engine/ui.js';
import { fillRoster } from '/engine/results.js';
import { inviteUrl } from '/engine/invite.js';
import { sound } from '/engine/fx.js';
import { roomCode, bootGame } from '/engine/game-shell.js';
import { {{Class}}Room } from './network.js';
import { TARGET } from './rules.js';

const $ = (id) => document.getElementById(id), params = new URLSearchParams(location.search);
const code = roomCode();
let world = null;
const room = new {{Class}}Room({ code, name: loadName(), avatar: loadAvatar(), onState: render,
  onNotice: (text) => { $('event').textContent = text; },
  onStatus(text, failed = false) { $('connection').textContent = text; $('practice').hidden = !failed; render(room.state); },
});
const menu = createGameMenu({ title: '{{name}} · Pana', sound, orientation: 'libre',
  note: () => room.members.size > 1 ? 'La partida sigue mientras estás en el menú.' : 'La partida está en pausa. Los bots te esperan.',
  controls: [['Espacio', 'Tirar el dado'], ['Ratón / toque', 'Botón Tirar dado'], ['M', 'Activar o silenciar el sonido']],
  tips: [`Tira el dado en tu turno. El primero en llegar a ${TARGET} puntos gana.`, 'Los puestos vacíos juegan con bots; un pana que llega toma su silla.'],
  invite: () => room.offline ? null : inviteUrl(code),
});
$('game-nav').append(menu.createInviteButton({ id: 'invite', className: 'pk-btn' }), menu.createButton({ id: 'menu', className: 'pk-btn' }));
$('rules').onclick = () => menu.open('controls');
$('start').onclick = $('again').onclick = () => { sound.unlock(); room.action('start'); };
$('practice').onclick = () => room.practice();
$('roll').onclick = () => act('roll');

const myTurn = () => room.connected && room.state.phase === 'playing' && room.seat === room.state.turn;
function act(action) { if (menu.isOpen || !myTurn()) return; sound.unlock(); room.action(action); }

function render(state) {
  const lobby = state.phase === 'lobby', ended = state.phase === 'finished';
  document.body.classList.toggle('in-lobby', lobby); $('lobby').hidden = !lobby; $('hud').hidden = lobby;
  $('start').disabled = !world || !room.connected || !room.isHost;
  $('start').textContent = !room.connected ? 'Conectando…' : room.isHost ? '¡A jugar!' : 'Espera al anfitrión';
  const rows = (players) => players.map((p, i) => ({ rank: i + 1, name: p.id === room.id ? `${p.name} · tú` : p.name, detail: p.id === null ? 'Bot' : 'Pana', end: p.score, score: true, me: p.id === room.id }));
  fillRoster($('roster'), rows(state.players));
  $('turn').textContent = ended ? '¡Partida terminada!' : myTurn() ? '¡Te toca tirar!' : `Turno de ${state.players[state.turn].name}`;
  $('last').textContent = state.lastRoll ? `Último dado: ${state.lastRoll}` : 'Nadie ha tirado todavía';
  $('roll').disabled = !myTurn();
  $('results').hidden = !ended; $('again').disabled = !room.connected || !room.isHost;
  if (ended) {
    $('result-title').textContent = `¡Ganó ${state.players[state.winner].name}!`;
    fillRoster($('result-roster'), rows([...state.players].sort((a, b) => b.score - a.score)));
  }
  world?.update(state);
}

addEventListener('keydown', (event) => {
  if (menu.isOpen || event.repeat || event.target.closest?.('input, textarea, select, [contenteditable]')) return;
  if (event.key.toLowerCase() === 'm') toggleMute();
  if (event.code === 'Space' && !event.target.closest?.('button, a')) { event.preventDefault(); act('roll'); }
});

render(room.state); room.connect();
export const { sceneReady } = bootGame({
  load: async () => (await import('./scene.js')).create{{Class}}Scene($('world')),
  ready: (created) => { world = created; render(room.state); },
  tick: (dt) => room.tick(dt, menu.isOpen && room.members.size <= 1),
  frame: (dt, scene) => scene.frame(dt),
  dispose: () => room.dispose(),
});
if (params.has('debug')) window.{{id}}Debug = { room, menu, get world() { return world; } };
